{
  "name": "iterum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:gpu": "node scripts/mode.mjs gputest",
    "bench": "node scripts/mode.mjs bench",
    "shots": "node scripts/mode.mjs shots",
    "voyages": "cargo run --release --manifest-path src-tauri/Cargo.toml --example voyage_targets > src/phenomena/mandelbrot/voyages.ts",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  }
}
